# Copy to .env. To enable the selected local model, install Ollama and pull gemma4:12b.
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

# Memory-conscious defaults. Increase context only if the host has spare memory.
AI_CONTEXT_TOKENS=4096
AI_OUTPUT_TOKENS=768
AI_MAX_CONCURRENT_REQUESTS=1
AI_EVIDENCE_LIMIT=5
AI_EVIDENCE_CHARS_PER_CHUNK=1000
AI_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=5m
